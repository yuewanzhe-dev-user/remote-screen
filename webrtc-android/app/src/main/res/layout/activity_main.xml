<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="智慧投屏"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvBoardsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="正在搜索本教室黑板…"
        android:textColor="#666"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/lvBoards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#eee"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="停止投屏"
        android:enabled="false"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="状态:未连接"
        android:layout_marginTop="12dp"
        android:textSize="14sp" />

    <!-- 画质由黑板 exe 教师控制,学生端不展示切换 -->
    <TextView
        android:id="@+id/tvQualityHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="画质由黑板控制(默认均衡)"
        android:textColor="#888"
        android:textSize="12sp"
        android:layout_marginTop="8dp" />

    <!-- 高级:搜不到时手输 -->
    <TextView
        android:id="@+id/tvAdvancedToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="高级设置 ▸"
        android:textColor="#2196F3"
        android:textSize="13sp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:id="@+id/layoutAdvanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="信令地址(如 192.168.1.100:8080)"
            android:textColor="#999"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="IP:端口"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="房间号(一般不用改,默认 default)"
            android:textColor="#999"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="default"
            android:inputType="text" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="手动开始投屏"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</LinearLayout>
